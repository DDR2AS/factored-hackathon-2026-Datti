 LAMBDA_EXCLUDES = ["**/__pycache__", "**/*.pyc", "**/*.ipynb", "etl"]
 
 
+@jsii.implements(cdk.ILocalBundling)
+class _PipLocalBundling:
+    """Bundle without Docker: pip downloads the Linux x86_64 / CPython 3.12 wheels of
+    src/requirements-lambda.txt (binary wheels only, so nothing is compiled on this machine)
+    and src/ is copied next to them. If pip fails, CDK falls back to the Docker image."""
+
+    def try_bundle(self, output_dir: str, options=None) -> bool:  # jsii passes both positionally
+        command = [
+            sys.executable, "-m", "pip", "install", "--quiet", "--no-cache-dir",
+            "--platform", "manylinux2014_x86_64", "--implementation", "cp",
+            "--python-version", "3.12", "--only-binary=:all:",
+            "--target", output_dir, "-r", str(SRC_DIR / "requirements-lambda.txt"),
+        ]
+        result = subprocess.run(command, check=False, capture_output=True, text=True)
+        if result.returncode != 0:
+            print(result.stdout + result.stderr, file=sys.stderr)
+            return False
+        shutil.copytree(
+            SRC_DIR, output_dir, dirs_exist_ok=True,
+            ignore=shutil.ignore_patterns("__pycache__", "*.pyc", "*.ipynb", "etl"),
+        )
+        return True
+
