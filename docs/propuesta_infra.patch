+
+
+def test_api_lambda_has_the_app_environment(dev):
+    functions = dev["api"].find_resources("AWS::Lambda::Function")
+    api = next(f for f in functions.values() if f["Properties"].get("FunctionName") == "expvivo-dev-api")
+    variables = api["Properties"]["Environment"]["Variables"]
+    assert variables["STORE_BACKEND"] in {"memory", "dynamodb"}
+    assert variables["LLM_PROVIDER"] in {"none", "mock", "bedrock"}
+    assert variables["TRACE_DIR"].startswith("/tmp/")  # the only writable path in Lambda
+    if variables["STORE_BACKEND"] == "memory":
+        assert api["Properties"].get("ReservedConcurrentExecutions") == 1
+
+
+def test_api_behavior_forwards_authorization(dev):
+    policies = dev["web"].find_resources("AWS::CloudFront::CachePolicy")
+    headers = [
+        p["Properties"]["CachePolicyConfig"]["ParametersInCacheKeyAndForwardedToOrigin"]["HeadersConfig"]
+        for p in policies.values()
+    ]
+    assert any("Authorization" in h.get("Headers", []) for h in headers)
