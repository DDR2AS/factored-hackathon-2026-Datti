# Entornos virtuales
.venv/
venv/
env/
.env

# Archivos de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebooks
.ipynb_checkpoints/

# Directorios de datos (Evita subir gigabytes a Git)
data/
*.duckdb
*.duckdb.wal
*.csv
*.parquet
*.json

# Módulos locales (no subir)
src/agent/
src/analysis/

# Archivos temporales o generados
proposal.txt
*.log

# SO y Editores
.DS_Store
.vscode/
.idea/

# CDK (infra/): keep the app config, ignore build output
infra/cdk.out/
!infra/cdk.json
!infra/cdk.context.json
node_modules/

# Front (frontend/, React + Vite): manifests and config that must be versioned.
# Must come after *.json so the exception wins. dist/ and node_modules/ stay ignored
# (frontend/.gitignore).
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json
!frontend/.oxlintrc.json
