AWS_BUCKET_NAME=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Local chat API (scripts/local_api.py). No secrets; real environment variables win.
# STAGE=local   (local_api.py already defaults to local; keep it commented so `make synth` keeps STAGE=dev)
STORE_BACKEND=memory
LLM_PROVIDER=mock
SESSION_TTL_MINUTES=15
LLM_TIMEOUT_SECONDS=8
# LOCAL_INVESTIGATION_DELAY_SECONDS=4
# SESSION_RATE_PER_MINUTE=60
# TRACE_DIR=data/traces
# LOCAL_ANALYST_TOKEN=   (optional; if missing, local_api.py generates one at start and prints it)
# --- v2 backends (INTERFACES.md #9). scripts/local_api.py uses the full v2 configuration by default;
# unset in other contexts = the M1 stand-ins (demo gateway, v1.4 rule, keywords, stub investigator).
# GATEWAY_BACKEND=composite        # demo | duckdb | composite (demo customers + gold customers)
# M1_BACKEND=model                 # rule | model (LightGBM LambdaRank; the rule if training kept it primary)
# M2_BACKEND=model                 # keywords | model
# INVESTIGATOR_BACKEND=g2          # stub | g2 (G2 agent; deterministic policy without model credentials)
# INVESTIGATOR_MAX_TOOL_CALLS=12
# INVESTIGATOR_MAX_SECONDS=90
# LLM_PROVIDER=mock|none|anthropic|bedrock (anthropic: ANTHROPIC_API_KEY en tu entorno, nunca en archivos)
# MODEL_CHAT=  MODEL_INVESTIGATOR=  MODEL_JUDGE=   (opcional; por defecto src/llm/models.yaml, D5)
# AWS_REGION=us-east-2             # bedrock
# DATA_DIR=data                    # raw/bronze/silver/gold/eval
# EVAL_REPORT_PATH=data/eval/report_latest.yaml
# SYNTH_CUSTOMERS=4000             # make data without the S3 key: size of the synthetic replica
